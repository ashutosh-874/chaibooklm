generator client {
  provider = "prisma-client"
  output   = "../packages/shared/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  notebooks    Notebook[]
}

model Notebook {
  id               String   @id @default(cuid())
  name             String
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  qdrantCollection String   @unique // e.g. `nb_${id}`; created on notebook create, dropped manually (not cascaded) on delete
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  sources          Source[]
  roadmaps         Roadmap[]
  podcasts         Podcast[]
  flashcardSets    FlashcardSet[]
}

enum SourceType {
  PDF
  TEXT
  URL
  YOUTUBE
  VTT
}

enum SourceStatus {
  UPLOADING
  INDEXING
  READY
  FAILED
}

model Source {
  id               String       @id @default(cuid())
  notebookId       String
  notebook         Notebook     @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  type             SourceType
  title            String
  status           SourceStatus @default(UPLOADING)
  errorMessage     String?
  originIdentifier String // file path (PDF/VTT), raw text, URL, or YouTube video ID depending on `type`
  metadata         Json? // shape depends on `type`, e.g. { pageCount } or { videoId, durationSec }
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  chunks           Chunk[]
}

model Chunk {
  id            String   @id @default(cuid())
  sourceId      String
  source        Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  qdrantPointId String   @unique
  chunkIndex    Int
  text          String
  locator       Json // shape depends on source type (page/offset/timestamp/cue); kept here, not just in Qdrant payload, so citation UI never round-trips to Qdrant
  createdAt     DateTime @default(now())
}

enum RoadmapStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

model Roadmap {
  id           String        @id @default(cuid())
  notebookId   String // a notebook can have many roadmaps, one per generated topic — kept and listed, not overwritten
  notebook     Notebook      @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  status       RoadmapStatus @default(PENDING)
  topic        String? // the concept/topic the user picked to scope generation to
  errorMessage String?
  concepts     Json? // [{ title, summary, orderRank, citations: [{ sourceId, chunkId, timestampSec }] }]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum PodcastStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

model Podcast {
  id           String        @id @default(cuid())
  notebookId   String // a notebook can have many podcasts — kept and listed, not overwritten
  notebook     Notebook      @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  status       PodcastStatus @default(PENDING)
  voice        String // "male" | "female"
  topic        String? // the concept/topic the user picked to scope the narration to
  script       String? // generated narration text, shown alongside the audio player
  audioPath    String? // on-disk path under apps/server/uploads, same convention as PDF/VTT sources
  errorMessage String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// Single linear status covers the whole "cards -> quiz" flow the user
// requested: suggested topics -> flashcards -> quiz from those flashcards.
enum FlashcardStatus {
  PENDING
  GENERATING
  CARDS_READY
  GENERATING_QUIZ
  QUIZ_READY
  FAILED
}

model FlashcardSet {
  id           String          @id @default(cuid())
  notebookId   String // a notebook can have many flashcard sets — kept and listed, not overwritten
  notebook     Notebook        @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  status       FlashcardStatus @default(PENDING)
  topic        String? // the concept/topic the user picked to scope generation to
  errorMessage String?
  flashcards   Json? // [{ front, back, sourceId, chunkId, sourceTitle, sourceType, locator, timestampSec }]
  quiz         Json? // [{ question, options: string[4], correctIndex, explanation }] — generated from `flashcards`, not raw sources
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

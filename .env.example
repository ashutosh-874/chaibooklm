PORT=8000
DATABASE_URL=postgresql://user:pass@localhost:5432/chaibooklm
# Local dev: redis://127.0.0.1:6379 — for managed Redis (e.g. Upstash) use the
# rediss:// TLS connection string, not the REST API URL/token.
REDIS_URL=redis://127.0.0.1:6379
QDRANT_URL=http://127.0.0.1:6333
# Required for managed Qdrant (e.g. Qdrant Cloud); leave blank for local dev.
QDRANT_API_KEY=
# S3-compatible object storage for uploaded PDF/VTT files and generated podcast
# mp3s — required in all environments (server and worker don't share a
# filesystem in production, so files are never kept on local disk).
# Defaults below point at the local MinIO service from docker-compose.yml
# (bucket auto-created by the minio-init service) — no cloud account needed
# for local dev. For production, point these at AWS S3 (leave S3_ENDPOINT
# blank) or Cloudflare R2 (set S3_ENDPOINT to your R2 endpoint).
S3_BUCKET=chaibooklm
S3_REGION=auto
S3_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
OPENAI_API_KEY=
YOUTUBE_DATA_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHAT_MODEL=gpt-4o-mini
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=4
RRF_K=60
RETRIEVAL_FINAL_K=5
JWT_SECRET=
JWT_EXPIRES_IN=7d
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE_MALE=en-US-Standard-D
GOOGLE_TTS_VOICE_FEMALE=en-US-Standard-F
